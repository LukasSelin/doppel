{
  "description": "doppel: corpus inventory at session start, request-scoped facts at each prompt, twin advisories before edits, near-duplicate probes after them (opt-in), duplication impact at end of turn",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.doppel_binary}",
            "args": ["hook", "session-start"],
            "timeout": 120,
            "statusMessage": "doppel: taking corpus snapshot"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.doppel_binary}",
            "args": ["hook", "user-prompt"],
            "timeout": 120,
            "statusMessage": "doppel: scoping to the request"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.doppel_binary}",
            "args": ["hook", "pre-tool"],
            "timeout": 15,
            "statusMessage": "doppel: checking for twins"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.doppel_binary}",
            "args": ["hook", "post-edit"],
            "timeout": 30,
            "statusMessage": "doppel: probing the edit for near duplicates"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.doppel_binary}",
            "args": ["hook", "stop"],
            "timeout": 120,
            "statusMessage": "doppel: measuring duplication impact"
          }
        ]
      }
    ]
  }
}
